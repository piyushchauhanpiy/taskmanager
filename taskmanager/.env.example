# ===========================================
# TaskManager Backend Environment Configuration
# ===========================================

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/taskmanager
MONGODB_DATABASE=taskmanager

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost

# JWT Configuration
JWT_SECRET=your-256-bit-secret-key-here-minimum-256-characters-long
JWT_EXPIRATION=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*

# Application Configuration
APP_NAME=TaskManager
APP_VERSION=1.0.0
APP_DESCRIPTION=Professional Task Management System

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/taskmanager.log

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_TIMEOUT=3600000

# Email Configuration (Optional - for future features)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@taskmanager.com

# Rate Limiting (Optional)
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_CAPACITY=100

# Monitoring (Optional)
SENTRY_DSN=your-sentry-dsn
METRICS_ENABLED=true

# Development/Production Flags
NODE_ENV=production
DEBUG=false

# UI Configuration
SUCCESS_MESSAGE_DURATION=5000
ERROR_MESSAGE_DURATION=5000
TASK_SUCCESS_DURATION=3000
API_TIMEOUT=30000
