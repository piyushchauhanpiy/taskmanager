# Development Environment Configuration
REACT_APP_API_URL=http://localhost:8080

# Production Environment Configuration (uncomment and update for production)
# REACT_APP_API_URL=https://your-production-api-domain.com

# Optional: Enable/disable React DevTools
# REACT_APP_DEVTOOLS=false

# Optional: Custom app title
# REACT_APP_TITLE=TaskManager

# Optional: Custom app description
# REACT_APP_DESCRIPTION=Professional Task Management System

# UI Configuration
REACT_APP_SUCCESS_MESSAGE_DURATION=5000
REACT_APP_ERROR_MESSAGE_DURATION=5000
REACT_APP_TASK_SUCCESS_DURATION=3000
REACT_APP_API_TIMEOUT=30000
